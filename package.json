{
  "name": "chelotext",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Челотекст — PWA, которая делает текст легче для чтения, сохраняя смысл, факты, имена, числа и цитаты",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings --watch server/index.js",
    "test": "node --no-warnings --test \"test/*.test.js\"",
    "eval": "node --no-warnings eval/run.js",
    "lint": "node --no-warnings scripts/check.js",
    "certs": "node --no-warnings scripts/certs.js"
  },
  "dependencies": {
    "@fontsource/literata": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@napi-rs/canvas": "^1.2.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "cheerio": "^1.0.0",
    "diff": "^5.2.0",
    "docx": "^9.0.2",
    "express": "^4.21.2",
    "mammoth": "^1.8.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "^4.6.82",
    "pdfkit": "^0.15.0",
    "tesseract.js": "^7.0.0"
  }
}
