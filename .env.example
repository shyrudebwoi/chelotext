# Челотекст — готовый шаблон окружения.
# Скопируй файл в .env (если его ещё нет) и впиши ТОЛЬКО доступ к GigaChat:
#   GIGACHAT_CRED  — ИЛИ  GIGACHAT_CLIENT_ID + GIGACHAT_CLIENT_SECRET.
# Все остальные значения уже заполнены и работают без правок.
# .env в git не попадает. Ни ключ, ни токен больше никуда не копируй.

# Сервер
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Опционально: если пусто, сервер сам создаст data/.session-secret.
SESSION_SECRET=
SECURE_COOKIES=false
TRUST_PROXY=false

# Хранилище
DATA_DIR=data
# DB_FILE=data/chelotext.sqlite  # опционально; по умолчанию data/chelotext.sqlite
RETENTION_DAYS=30

# Лимиты (ТЗ 4.3, 4.3.1)
MAX_CHARS=100000
MAX_PDF_PAGES=50
MAX_UPLOAD_BYTES=26214400

# Синхронный путь до ~60 сек, дальше — очередь.
# 1 воркер: у физлиц GigaChat разрешает один поток.
SYNC_MAX_CHARS=12000
SYNC_MAX_MS=55000
JOB_CONCURRENCY=1
OCR_CONCURRENCY=1

# Rate limit
RL_LOGIN_PER_HOUR=10
RL_REGISTER_PER_HOUR=5
RL_PROCESS_PER_HOUR=30
RL_UPLOAD_PER_HOUR=20
RL_GLOBAL_PER_MINUTE=240

# LLM: GigaChat включён. Если ключ не задан — тихий fallback на движок правил.
LLM_PROVIDER=gigachat
LLM_ENABLED=true
LLM_MODEL=GigaChat-2
# LLM_BASE_URL и LLM_API_KEY здесь не используются (это для ollama/openai).
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=
LLM_TIMEOUT_MS=45000
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
LLM_CHUNK_CHARS=3000
LLM_TEMPERATURE=0.2

# ============================================================
# ЕДИНСТВЕННОЕ, ЧТО НУЖНО ЗАПОЛНИТЬ ВРУЧНУЮ
# Студия Сбера → проект GigaChat API → Настройки API → Получить ключ.
# Значения показываются один раз; скопируй сразу в .env, не в чат.
#
# Вариант 1: готовый Authorization Key.
GIGACHAT_CRED=
# Вариант 2 (вместо GIGACHAT_CRED): Client ID + Client Secret.
# Сервер сам соберёт Authorization Key как base64(client_id:client_secret).
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# ============================================================

# Остальные настройки GigaChat менять не нужно.
# Физлицам — GIGACHAT_API_PERS; ИП/юрлицам — GIGACHAT_API_B2B / GIGACHAT_API_CORP.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_API_URL=https://api.giga.chat/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_USER_AGENT=chelotext/1.0
# Обновлять токен за 60 сек до окончания срока (токен живёт 30 минут).
GIGACHAT_TOKEN_SKEW_MS=60000
# Корневой PEM НУЦ Минцифры; скачать: npm run certs. Проверку TLS не отключать.
GIGACHAT_CA_FILE=certs/russian_trusted_root_ca.crt

# OCR: Tesseract (самохостимый, бесплатный)
OCR_ENABLED=true
OCR_LANGS=rus+eng
OCR_DPI=200
OCR_MIN_CONFIDENCE=60

# Юридическое
POLICY_VERSION=2026-11-24
OPERATOR_NAME=Оператор сервиса «Челотекст»
OPERATOR_EMAIL=privacy@chelotext.local
