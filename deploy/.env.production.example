# Челотекст — шаблон окружения для VDS.
# Скопируй в /opt/chelotext/.env и впиши ТОЛЬКО доступ к GigaChat (три поля ниже).
# Секреты не коммитятся: .env в .gitignore и в .dockerignore.

# Сервер (за HTTPS отвечает nginx на хосте)
NODE_ENV=production
PORT=3000
# Для Docker оставь HOST=0.0.0.0; для systemd + nginx хватит 127.0.0.1.
HOST=0.0.0.0
SESSION_SECRET=
SECURE_COOKIES=true
TRUST_PROXY=true

# Хранилище
DATA_DIR=data
RETENTION_DAYS=30

# Лимиты (ТЗ 4.3, 4.3.1)
MAX_CHARS=100000
MAX_PDF_PAGES=50
MAX_UPLOAD_BYTES=26214400

# Очередь: у физлиц GigaChat разрешает один поток.
SYNC_MAX_CHARS=12000
SYNC_MAX_MS=55000
JOB_CONCURRENCY=1
OCR_CONCURRENCY=1

# Rate limit
RL_LOGIN_PER_HOUR=10
RL_REGISTER_PER_HOUR=5
RL_PROCESS_PER_HOUR=30
RL_UPLOAD_PER_HOUR=20
RL_GLOBAL_PER_MINUTE=240

# LLM: GigaChat включён. Без ключа — тихий fallback на движок правил.
LLM_PROVIDER=gigachat
LLM_ENABLED=true
LLM_MODEL=GigaChat-2
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=
LLM_TIMEOUT_MS=45000
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
LLM_CHUNK_CHARS=3000
LLM_TEMPERATURE=0.2

# ============================================================
# ЕДИНСТВЕННОЕ, ЧТО НУЖНО ЗАПОЛНИТЬ ВРУЧНУЮ
# Студия Сбера → проект GigaChat API → Настройки API → Получить ключ.
# Вариант 1: готовый Authorization Key.
GIGACHAT_CRED=
# Вариант 2 (вместо GIGACHAT_CRED): Client ID + Client Secret.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# ============================================================

GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_API_URL=https://api.giga.chat/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_USER_AGENT=chelotext/1.0
GIGACHAT_TOKEN_SKEW_MS=60000
# Путь относительно /app (Docker) или /opt/chelotext (systemd).
GIGACHAT_CA_FILE=certs/russian_trusted_root_ca.crt

# OCR
OCR_ENABLED=true
OCR_LANGS=rus+eng
OCR_DPI=200
OCR_MIN_CONFIDENCE=60

# Юридическое — замени на свои реквизиты перед публикацией.
POLICY_VERSION=2026-11-24
OPERATOR_NAME=Оператор сервиса «Челотекст»
OPERATOR_EMAIL=privacy@chelotext.local
